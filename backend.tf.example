# backend.tf.example
#
# Copy this file into a NEW Terraform project's repo as `backend.tf`, then
# fill in the values below using this repo's outputs plus a key you pick:
#
#   terraform output resource_group_name
#   terraform output storage_account_name
#   terraform output container_name
#
# IMPORTANT — Terraform-specific gotcha coming from Bicep: a `backend`
# block cannot reference variables, resources, data sources, or any other
# expression — every value must be a hard-coded literal string. This is
# different from every other block in Terraform, because the backend has
# to be resolved before Terraform has loaded the rest of the config (it's
# read before variables even exist, since it determines *where* to go
# looking for state in the first place).

terraform {
  backend "azurerm" {
    # resource_group_name is optional with use_azuread_auth. The
    # key-scoped isolation test (examples/) ran WITHOUT it, i.e. pure
    # blob-data calls; that's the tested path for an identity that has no
    # ARM (control-plane) role. Drop this line if init hits a 403 on it.
    resource_group_name  = "rg-tfstate-backend"    # from this repo's `terraform output resource_group_name`
    storage_account_name = "sttfstatebackend001"   # from this repo's `terraform output storage_account_name`
    container_name       = "tfstate"               # from this repo's `terraform output container_name`

    # Unique per consuming project — this is the blob name your state
    # file will live under inside the shared container. It must EXACTLY
    # match the `state_key` your project is granted under `consumers` in
    # this repo: access is limited to that key by an ABAC condition, so a
    # mismatch is a 403, not a silent collision.
    key = "REPLACE-WITH-PROJECT-NAME.tfstate" # e.g. "azure-data-tier-lab.tfstate"

    # Authenticate via Azure AD / RBAC rather than a storage account
    # access key. Requires the deploying identity (your local `az login`
    # user, or the OIDC-federated identity in CI) to be listed under your
    # project in `consumers` (key-scoped "Storage Blob Data Contributor").
    use_azuread_auth = true
  }
}

# After copying this in: run `terraform init`. Terraform will detect the
# new backend config and prompt to initialize it. State locking needs no
# separate setup — the azurerm backend takes a blob lease automatically
# (see this repo's README, "State locking").
